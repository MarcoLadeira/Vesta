{
  "name": "opai-web-ui-tests",
  "private": true,
  "version": "0.0.0",
  "description": "JS unit (Vitest) + E2E (Playwright) tests for the Vesta web UI front-end (opai/assets/web).",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "test:tokens": "node scripts/lint-web-design-tokens.mjs && node --test opai/assets/web/__tests__/design-tokens.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "vitest": "^4.1.9"
  }
}
