.vestahub/

cache/*
logs/*
!cache/.gitkeep
!logs/.gitkeep

**/.opcoding/cache/*
**/.opcoding/logs/*
**/.opcoding/*.local.*
**/.opcoding/secrets.*

.env
.env.*
.env.local
*.key
*.pem
id_rsa*

# Generated per-launch cache-busted GUI index (vesta/gui_web.py)
vesta/assets/web/.runtime-index.html

# Generated only inside wheel/sdist staging by setup.py.
vesta/_embedded_build.json
.worktrees

# #618: machine-readable Playwright result, read by ci_local for diagnostics.
# Regenerated per run; never committed.
playwright-results.json
