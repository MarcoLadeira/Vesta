{
  "branch_rule": {
    "allow_bypass": false,
    "allow_deletion": false,
    "allow_force_push": false,
    "dismiss_stale_approvals": true,
    "require_all_checks": true,
    "require_conversation_resolution": true,
    "require_up_to_date": true
  },
  "component_contracts": {
    "hostile": [
      "hostile-unittest",
      "hostile-pytest"
    ],
    "native": [
      "isolated-wheel-smoke"
    ],
    "provider": [
      "provider-canary"
    ],
    "python": [
      "ruff-format",
      "ruff-lint",
      "lifecycle-projection-drift",
      "release-identity-drift",
      "lifecycle-test-collection",
      "python-unittest",
      "python-pytest",
      "registry-validation",
      "bandit",
      "detect-secrets"
    ],
    "supply-chain": [
      "python-pytest",
      "pip-audit"
    ],
    "web": [
      "npm-ci",
      "npm-audit",
      "web-design-tokens",
      "web-unit",
      "playwright-browser-install",
      "web-e2e"
    ]
  },
  "profiles": {
    "fast": {
      "automatic": [
        "pull_request:main",
        "pull_request:release/**",
        "pull_request:rc/**",
        "merge_group",
        "push:main",
        "push:release/**",
        "push:rc/**",
        "schedule:17 3 * * 1"
      ],
      "components": [
        "python",
        "hostile",
        "web"
      ],
      "manual": [
        "workflow_dispatch:fast",
        "workflow_dispatch:full"
      ]
    },
    "full": {
      "automatic": [
        "schedule:17 3 * * 1"
      ],
      "components": [
        "python",
        "hostile",
        "web",
        "supply-chain"
      ],
      "manual": [
        "workflow_dispatch:full"
      ]
    },
    "native": {
      "automatic": [
        "schedule:17 3 * * 1"
      ],
      "components": [
        "native"
      ],
      "manual": [
        "workflow_dispatch:full"
      ]
    },
    "provider-canary": {
      "automatic": [
        "schedule:43 4 * * 2"
      ],
      "components": [
        "provider"
      ],
      "manual": [
        "workflow_dispatch:main",
        "desktop-artifacts:workflow_dispatch:main:production"
      ],
      "protected_environment": "opai-provider-canary"
    },
    "release": {
      "automatic": [],
      "components": [
        "python",
        "hostile",
        "web",
        "supply-chain",
        "native",
        "provider"
      ],
      "final_artifact_qualification": {
        "automatic": [],
        "manual": [
          "workflow_dispatch:main:production"
        ],
        "protected_environment": "opai-production-signing"
      },
      "manual": [
        "local:scripts/ci_local.py:release"
      ],
      "source_preflight": {
        "automatic": [
          "push:release/**",
          "push:rc/**"
        ],
        "manual": [
          "workflow_dispatch"
        ]
      },
      "unsigned_artifact_rehearsal": {
        "automatic": [
          "push:tag:v*"
        ]
      }
    }
  },
  "protected_branch": "main",
  "protected_branches": [
    "main",
    "release/**",
    "rc/**"
  ],
  "required_checks": [
    {
      "component": "python",
      "job": "mandatory-python",
      "job_name_template": "Required - Python quality (${{ matrix.python-version }})",
      "name": "Required - Python quality (3.13)",
      "required_check_ids": [
        "candidate-sha",
        "ruff-format",
        "ruff-lint",
        "lifecycle-projection-drift",
        "release-identity-drift",
        "lifecycle-test-collection",
        "python-unittest",
        "python-pytest",
        "registry-validation",
        "bandit",
        "detect-secrets"
      ],
      "trusted_app": "github-actions",
      "workflow": "Vesta CI (hosted)"
    },
    {
      "component": "hostile",
      "job": "mandatory-hostile-environment",
      "job_name_template": "Required - hostile-environment Python suites",
      "name": "Required - hostile-environment Python suites",
      "required_check_ids": [
        "candidate-sha",
        "hostile-unittest",
        "hostile-pytest"
      ],
      "trusted_app": "github-actions",
      "workflow": "Vesta CI (hosted)"
    },
    {
      "component": "web",
      "job": "web-test",
      "job_name_template": "Required - web UI security and E2E",
      "name": "Required - web UI security and E2E",
      "required_check_ids": [
        "candidate-sha",
        "npm-ci",
        "npm-audit",
        "web-design-tokens",
        "web-unit",
        "playwright-browser-install",
        "web-e2e"
      ],
      "trusted_app": "github-actions",
      "workflow": "Vesta CI (hosted)"
    }
  ],
  "schema_version": 2,
  "workflow": ".github/workflows/ci.yml"
}
